\name{cerddb}
\alias{cerddb}
\docType{data}
\title{
Ceramides database
}
\description{
In silico generated database for ceramides.
}
\usage{data("cerddb")}
\format{
  Data frame with 89 observations and the following 4 variables.
  \describe{
    \item{\code{formula}}{character vector containing molecular formulas.}
    \item{\code{total}}{character vector indicating the total number of carbons and double bonds of the chains.}
    \item{\code{Mass}}{numeric vector with the neutral masses.}
    \item{\code{ID}}{character vector containing the unique lipid identifiers.}
  }
}
\keyword{datasets}
