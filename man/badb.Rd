\name{badb}
\alias{badb}
\docType{data}
\title{
Bile acids database
}
\description{
In silico generated database for bile acids.
}
\usage{data("badb")}
\format{
  Data frame with 9 observations and the following 5 variables.
  \describe{
    \item{\code{formula}}{character vector containing molecular formulas.}
    \item{\code{total}}{character vector indicating the total number of carbons and double bonds of the chains.}
    \item{\code{Mass}}{numeric vector with the neutral masses.}
    \item{\code{conjugate}}{character vector containing conjugate.}
    \item{\code{base}}{character vector containing base.}
  }
}
\keyword{datasets}
