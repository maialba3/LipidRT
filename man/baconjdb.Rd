\name{baconjdb}
\alias{baconjdb}
\docType{data}
\title{
Bile acid conjugates database
}
\description{
In silico generated database for bile acid conjugates.
}
\usage{data("baconjdb")}
\format{
  Data frame with 2 observations and the following 2 variables.
  \describe{
    \item{\code{total}}{character vector indicating the total number of carbons and double bonds of the chains.}
    \item{\code{Mass}}{numeric vector with the neutral masses.}
  }
}
\keyword{datasets}
